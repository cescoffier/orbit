# Quarkus Orbit - Environment Variables
# Copy this file to .env and fill in your actual values.

# GitHub Personal Access Token
# Create one at: https://github.com/settings/tokens
# Required scopes: repo, read:org, read:discussion
GITHUB_TOKEN=ghp_your_token_here

# Google Gemini API Key
# Get one at: https://aistudio.google.com/app/apikey
# Used by: all modules (AI-powered analysis and classification)
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI API Key (optional)
# Used by: working-group-reporting cli-app (status update generation)
OPENAI_API_KEY=your_openai_api_key_here
